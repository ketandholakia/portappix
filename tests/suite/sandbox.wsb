<?xml version="1.0" encoding="utf-8"?>
<!--
  Portappix validation gates: Windows Sandbox configuration.

  A clean Windows Sandbox contains only native Windows tools (powershell.exe, cmd.exe, reg.exe).
  It does NOT contain Python, Git, or Delphi. All build steps must run on the HOST first:
    1. Build Launcher:              scripts\build_launcher.cmd all
    2. Build Fake Apps:             tests\fakeapps\build.cmd
    3. Build Self-Update Fixtures:  powershell -ExecutionPolicy Bypass -File scripts\build_selfupdate_fixture.ps1

  Adjust <HostFolder> paths below to match your host paths before launching.
  The repository is mapped READ-ONLY into Desktop\portappix.
  Results are written to the mapped READ-WRITE folder Desktop\PortappixSuiteResults.
-->
<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\Admin\Documents\github\portappix</HostFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\Public\PortappixSuiteResults</HostFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoExit -ExecutionPolicy Bypass -Command "Set-Location C:\users\WDAGUtilityAccount\Desktop\portappix; Write-Host 'Portappix Windows Sandbox Validation Ready.' -ForegroundColor Green; Write-Host 'Available gates:'; Write-Host '  Gate 1 (Crash Harness)     : .\tests\suite\run_crash_validation.ps1 -Results C:\users\WDAGUtilityAccount\Desktop\PortappixSuiteResults'; Write-Host '  Gate 2 (Compatibility)    : .\tests\suite\run_suite.ps1 -Results C:\users\WDAGUtilityAccount\Desktop\PortappixSuiteResults -Launcher .\bin\Launcher.exe'; Write-Host '  Gate 3 (Self-Update)       : .\tests\suite\run_selfupdate_validation.ps1 -FixtureDir .\tests\suite\fixtures\selfupdate'; Write-Host ''; Write-Host 'Executing Gate 2 (Compatibility Suite)...' -ForegroundColor Cyan; .\tests\suite\run_suite.ps1 -Results C:\users\WDAGUtilityAccount\Desktop\PortappixSuiteResults -Launcher .\bin\Launcher.exe"</Command>
  </LogonCommand>
</Configuration>
